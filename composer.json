{
    "name": "owl-admin/tenancy",
    "alias": "多租户",
    "description": "Owl Admin 多租户扩展：共享数据库 + tenant_id 作用域",
    "type": "library",
    "version": "1.0.0",
    "keywords": [
        "owl-admin",
        "extension"
    ],
    "homepage": "https://github.com/owl-admin/tenancy",
    "license": "MIT",
    "authors": [
        {
            "name": "slowlyo",
            "email": "slowlyo_email@qq.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "slowlyo/owl-admin": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "OwlAdmin\\Tenancy\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OwlAdmin\\Tenancy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "extra": {
        "owl-admin": "OwlAdmin\\Tenancy\\TenancyServiceProvider",
        "laravel": {
            "providers": [
                "OwlAdmin\\Tenancy\\TenancyServiceProvider"
            ]
        }
    }
}
